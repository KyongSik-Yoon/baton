{
  "description": "opus5-router mode: inject the orchestrator posture each turn and block main-agent mutations at the tool layer while the flag file exists.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/orchestrator-mode.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/orchestrator-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
